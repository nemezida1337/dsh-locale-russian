{
  "name": "dsh-locale-russian",
  "version": "0.7.0",
  "description": "Russian localization for the DeepSeek Harness web client, with local Russian speech recognition for voice input",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "locale/*.json",
    "cordis.patch.yml",
    "install.sh",
    "icon.svg",
    "dictionary/ru.json",
    "dictionary/plugin-meta.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "GLOSSARY.md",
    "STYLE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "inventory": "node tools/build-inventory.mjs",
    "lint": "node tools/lint-translations.mjs",
    "build": "node tools/build-package.mjs",
    "verify": "node tools/verify-package.mjs",
    "test": "npm run lint && npm run check-imports && npm run build && npm run verify && npm run check-docs && npm run check-consistency && npm run history:check && npm run test:install-bin && npm run test:install-desktop && npm run test:speech && npm run test:engine && npm run test:prewarm && npm run test:translate && npm run test:review && npm run test:dashboard && npm run test:check-app && npm run test:market-live && npm run test:scaffold && npm run test:discussions && npm run test:history && npm run test:consistency && npm run test:check-docs",
    "market": "node tools/build-market.mjs",
    "asar": "node tools/extract-asar.mjs",
    "refresh": "node tools/refresh.mjs",
    "refresh:check": "node tools/refresh.mjs --check",
    "mark-translated": "node tools/mark-translated.mjs",
    "plugin-meta": "node tools/extract-plugin-meta.mjs && node tools/build-plugin-batches.mjs",
    "sweep": "node tools/gui-sweep.mjs",
    "sweep:check": "node tools/gui-sweep.mjs --compare --fail-on-clip",
    "validate-market": "node tools/validate-market.mjs",
    "check-imports": "node tools/check-imports.mjs",
    "test:speech": "node tools/test-speech-provider.mjs",
    "test:install-bin": "node --check bin/dsh-locale-russian-install.mjs",
    "translate": "node tools/translate-batches.mjs",
    "test:translate": "node tools/test-translate-batches.mjs",
    "test:engine": "node tools/test-engine-install.mjs",
    "dashboard": "node tools/build-dashboard.mjs",
    "test:dashboard": "node tools/test-dashboard.mjs",
    "check:app": "node tools/check-app.mjs",
    "test:check-app": "node tools/test-check-app.mjs",
    "scaffold": "node tools/scaffold-locale.mjs",
    "test:scaffold": "node tools/test-scaffold.mjs",
    "test:discussions": "node tools/test-discussion-report.mjs",
    "review": "node tools/review-translations.mjs",
    "test:review": "node tools/test-review-translations.mjs",
    "test:prewarm": "node tools/test-prewarm.mjs",
    "check-docs": "node tools/check-docs.mjs",
    "test:check-docs": "node tools/test-check-docs.mjs",
    "engine:smoke": "node tools/engine-smoke.mjs",
    "market:live": "node tools/market-live.mjs",
    "test:market-live": "node tools/test-market-live.mjs",
    "history": "node tools/build-history.mjs",
    "history:check": "node tools/build-history.mjs --check",
    "test:history": "node tools/test-history.mjs",
    "demo:gif": "node tools/demo-gif.mjs",
    "check-consistency": "node tools/check-consistency.mjs",
    "test:consistency": "node tools/test-consistency.mjs",
    "test:install-desktop": "node tools/test-install-desktop.mjs"
  },
  "license": "MIT",
  "engines": {
    "dsh": "^0.1.5-rc.1 || ^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemezida1337/dsh-locale-russian.git"
  },
  "homepage": "https://github.com/nemezida1337/dsh-locale-russian#readme",
  "bugs": {
    "url": "https://github.com/nemezida1337/dsh-locale-russian/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "locale",
    "localization",
    "i18n",
    "russian",
    "ru",
    "plugin"
  ],
  "author": "dsh-locale-ru contributors",
  "bin": {
    "dsh-locale-russian-install": "./bin/dsh-locale-russian-install.mjs"
  }
}
